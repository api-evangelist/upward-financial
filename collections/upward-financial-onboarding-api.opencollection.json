                "description": "Consumer ID"
              },
              {
                "name": "consumer_pcid",
                "value": "",
                "type": "query",
                "description": "Consumer PCID"
              }
            ]
          },
          "docs": "1) Get Partner from request\n2) Get Partner Onboardings and filter (pcid or external id) if needed\n3) Return a list of onboardings with their id and consumer data"
        },
